{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/BuildAll/InvokeMsBuild.ps1",
        "${workspaceFolder}/Tiefsee/Tiefsee.csproj",
        "-OutputPath",
        "${workspaceFolder}/Output/"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/BuildAll/InvokeMsBuild.ps1",
        "${workspaceFolder}/Tiefsee/Tiefsee.csproj",
        "-Target",
        "Publish",
        "-OutputPath",
        "${workspaceFolder}/Output/"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Tiefsee/Tiefsee.csproj",
        "/p:OutputPath=${workspaceFolder}/Output/", // 指定輸出路徑
        "/p:BuildNativeHost=false"
      ],
      "problemMatcher": "$msCompile"
    },

    // ---

    // 編譯全部專案
    {
      "label": "buildAll",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/BuildAll/InvokeMsBuild.ps1",
        "${workspaceFolder}/BuildAll/BuildAll.csproj",
        "-OutputPath",
        "${workspaceFolder}/Output/"
      ],
      "problemMatcher": "$msCompile"
    },

  ]
}
