<div id="video-toolbar" class="video-toolbar" visible="false">
    <div class="video-toolbar-content">
        <div class="video-toolbar-progress">
            <input class="video-toolbar-progress-input" type="range" min="0" max="0" step="any" value="0" title="影片進度" i18n="videoToolbar.progress">
        </div>

        <div class="video-toolbar-controls">
            <div class="video-toolbar-left">
                <button class="video-toolbar-button video-toolbar-motion-photo" type="button" visible="false" i18n="motionPhoto.showVideo" aria-label="" title="">
                    <svg class="video-toolbar-motion-photo-icon video-toolbar-motion-photo-icon--dynamic" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="2.5" y="3.5" width="15" height="17" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
                        <path d="m4.5 18 3.5-4.5 2.5 2.5 2-2 3 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M19.5 8c1 1 1 2 0 3m1.5-4.5c2 2 2 4 0 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                    <svg class="video-toolbar-motion-photo-icon video-toolbar-motion-photo-icon--still" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="2.5" y="3.5" width="19" height="17" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
                        <circle cx="9" cy="9" r="1.7" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <path d="m4.5 18 4.5-4.5 3 3 2.5-2.5 4.5 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="video-toolbar-motion-photo-label" i18n="motionPhoto.dynamic">動態</span>
                </button>
                <button class="video-toolbar-button video-toolbar-play" type="button" title="播放" i18n="videoToolbar.play">
                    <span class="video-toolbar-play-icon" style="padding-left: 3px;">
                        <%- await readFile("./img/default/icon-play.svg"); %>
                    </span>
                    <span class="video-toolbar-pause-icon">
                        <%- await readFile("./img/default/icon-pause.svg"); %>
                    </span>
                </button>

                <div class="video-toolbar-volume-group">
                    <button class="video-toolbar-button video-toolbar-volume-button" type="button" title="靜音" i18n="videoToolbar.mute">
                        <span class="video-toolbar-volume-icon">
                            <%- await readFile("./img/default/icon-volume.svg"); %>
                        </span>
                        <span class="video-toolbar-volume-mute-icon">
                            <%- await readFile("./img/default/icon-volumeMute.svg"); %>
                        </span>
                    </button>
                    <input class="video-toolbar-volume-input" type="range" min="0" max="1" step="0.01" value="1" title="音量" i18n="videoToolbar.volume">
                </div>

                <span class="video-toolbar-time" title="播放時間" i18n="videoToolbar.playbackTime">0:00 / 0:00</span>
            </div>

            <div class="video-toolbar-right">
                <button class="video-toolbar-button video-toolbar-rate-button" type="button" title="播放速度" i18n="videoToolbar.playbackSpeed">
                    <span class="video-toolbar-rate-value">1x</span>
                </button>
            </div>
        </div>
    </div>
</div>
