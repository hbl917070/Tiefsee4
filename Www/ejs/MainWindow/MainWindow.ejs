<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tiefsee 4</title>

    <!-- 空白 icon -->
    <link rel="icon" href="data:image/x-icon;,">

    <!--google字體-->
    <!-- <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100&display=swap" rel="stylesheet"> -->

    <script src="./vender/jquery/jquery.min.js"></script>
    <script src="./vender/jquery-easing/jquery.easing.min.js"></script>

    <script src="./js/SvgList.js"></script>
    <script src="./lang/langData.js"></script>

    <script src="./js/MainWindow.js"></script>
    <link rel="stylesheet" href="./css/MainWindow.css">
</head>

<body showType="bulkView">

    <div class="window">

        <div class="dragbar-v" id="dragbar-mainFileList" role="separator" aria-orientation="vertical" aria-label="" i18n="sw.filePanel.resizeWidth"> </div>
        <div class="dragbar-v" id="dragbar-mainDirList" role="separator" aria-orientation="vertical" aria-label="" i18n="sw.directoryPanel.resizeWidth"> </div>
        <div class="dragbar-v" id="dragbar-mainExif" role="separator" aria-orientation="vertical" aria-label="" i18n="sw.informationPanel.resizeWidth"> </div>

        <!-- 標題列 -->
        <div id="window-titlebar" class="window-titlebar">

            <div id="titlebar-custom-toolbar-left" class="titlebar-custom-toolbar titlebar-custom-toolbar-left"></div>

            <div class="titlebar-text" id="window-titlebar-text">
                <span>tiefsee 4</span>
            </div>

            <div class="titlebar-toolbar">

                <div id="titlebar-custom-toolbar-right" class="titlebar-custom-toolbar titlebar-custom-toolbar-right"></div>

                <div class="titlebar-toolbar-btn titlebar-toolbar-exitFullScreen" title="結束全螢幕" i18n="menu.exitFullScreen" role="button" style="display:none;">
                    <%- await readSvg("arrow_minimize_20_regular.svg"); %>
                </div>
                <div class="titlebar-toolbar-btn titlebar-toolbar-minimized" role="button" i18n="script.minimizeWindow" title="">
                    <%- await readSvg("window_minimized.svg"); %>
                </div>
                <div class="titlebar-toolbar-btn titlebar-toolbar-normal" role="button" i18n="script.restoreWindow" title="" style="display:none;">
                    <%- await readSvg("window_normal.svg"); %>
                </div>
                <div class="titlebar-toolbar-btn titlebar-toolbar-maximized" role="button" i18n="script.maximizeWindow" title="">
                    <%- await readSvg("window_maximized.svg"); %>
                </div>
                <div class="titlebar-toolbar-btn titlebar-toolbar-close" role="button" i18n="script.closeWindow" title="">
                    <%- await readSvg("window_close.svg"); %>
                </div>
            </div>

        </div>

        <div class="window-body" id="window-body">

            <div class="main-content">

                <!-- loading -->
                <div id="loadingWindow">
                    <img src="./img/loading.svg">
                </div>

                <div id="main-T" class="main-T">
                    <!-- 工具列 -->
                    <div id="main-toolbar" class="main-toolbar main-toolbar__scrollbar">

                        <div id="toolbar-content" class="toolbar-content">
                        </div>

                    </div>
                </div>

                <div class="main-C">

                    <div id="main-L" class="main-L">

                        <!-- 資料夾預覽面板 -->
                        <div class="main-item main-dirList base-scrollbar-mini" id="main-dirList" data-menu="dirPanel">
                            <div class="main-dirListBody" id="main-dirListBody">
                                <div id="main-dirListData"> </div>
                            </div>
                        </div>
                    </div>

                    <div class="main-L2">
                        <!-- 檔案預覽面板 -->
                        <div class="main-item main-fileList base-scrollbar-mini" id="main-fileList" data-menu="filePanel">
                            <div class="main-fileListBody" id="main-fileListBody">
                                <div id="main-fileListData"></div>
                            </div>
                        </div>
                    </div>

                    <div class="main-V">

                        <!-- 影片播放工具列 -->
                        <%- await include("./VideoToolbar.ejs"); %>

                        <div id="mView-welcome" class="mView-welcome">
                            <div>
                                <img class="mView-welcome-logo" src="./img/logo.svg">
                                <div class="mView-welcome-text">Tiefsee 4.3.2</div>
                            </div>
                        </div>
                        <textarea id="mView-text" class="mView-text base-scrollbar" readonly2="" aria-labelledby="window-titlebar-text"></textarea>
                        <div id="mView-tiefseeview" class="mView-tiefseeview" role="region" aria-label="" i18n="script.imageViewportPan"></div>
                        <iframe id="mView-pdf" class="mView-iframe"></iframe>
                        <iframe id="mView-pdftronWebviewer" class="mView-iframe"></iframe>
                        <iframe id="mView-monacoEditor" class="mView-iframe"></iframe>
                        <iframe id="mView-cherryMarkdown" class="mView-iframe"></iframe>

                        <!-- 大量瀏覽模式 -->
                        <div id="mView-bulkView" class="bulkView">
                            <div class="bulkView-scroll-content">
                                <div class="bulkView-pagination">
                                    <div class="bulkView-pagination-box">
                                        <div class="bulkView-pagination-prev svg-box" role="button" aria-label="" i18n="script.prevPageTop" freeze="true" aria-disabled="true">
                                            <%- await readSvg("arrow_left_20_regular.svg"); %>
                                        </div>
                                        <select class="bulkView-pagination-select" aria-label="" i18n="script.pageNumberTop">
                                        </select>
                                        <div class="bulkView-pagination-next svg-box" role="button" aria-label="" i18n="script.nextPageTop" aria-disabled="true">
                                            <%- await readSvg("arrow_right_20_regular.svg"); %>
                                        </div>
                                    </div>
                                </div>
                                <div class="bulkView-content" show=""></div>
                                <div class="bulkView-pagination">
                                    <div class="bulkView-pagination-box">
                                        <div class="bulkView-pagination-prev svg-box" role="button" aria-label="" i18n="script.prevPageBottom" aria-disabled="true">
                                            <%- await readSvg("arrow_left_20_regular.svg"); %>
                                        </div>
                                        <select class="bulkView-pagination-select" aria-label="" i18n="script.pageNumberBottom">
                                        </select>
                                        <div class="bulkView-pagination-next svg-box" role="button" aria-label="" i18n="script.nextPageBottom" aria-disabled="true">
                                            <%- await readSvg("arrow_right_20_regular.svg"); %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 大型切換按鈕 -->
                        <div id="largeBtnLeft" class="largeBtn" data-style="leftRight-L" role="button" aria-label="" i18n="menu.prevFile">
                            <div class="box svg-box">
                                <%- await readSvg("arrow_left_20_regular.svg"); %>
                            </div>
                        </div>
                        <div id="largeBtnRight" class="largeBtn" data-style="leftRight-R" role="button" aria-label="" i18n="menu.nextFile">
                            <div class="box svg-box">
                                <%- await readSvg("arrow_right_20_regular.svg"); %>
                            </div>
                        </div>

                        <!-- <embed  id="main-pdfview" class="main-pdfview" src="" type="application/pdf"> -->
                    </div>

                    <div class="main-R" id="main-R">

                        <!-- exif 視窗 -->
                        <div class="mainExif" id="mainExif">

                            <div class="mainExifTop">
                                <div class="mainExifTabs js-tabBtns main-toolbar__scrollbar " role="tablist" aria-label="" i18n="menu.information" aria-orientation="horizontal">
                                    <div class="mainExifTabsContent">
                                        <!-- 資訊 -->
                                        <div class="mainExifTabsItem js-tabBtn-info svg-box" mark="true" i18n="menu.information" title="" role="tab" aria-selected="true" id="mainExif-tab-info" aria-controls="mainExif-tabpanel-info">
                                            <%- await readSvg("data_usage_20_regular.svg"); %>
                                        </div>
                                        <!-- 相關檔案 -->
                                        <div class="mainExifTabsItem js-tabBtn-related svg-box" mark="true" i18n="menu.relatedFiles" title="" role="tab" aria-selected="false" id="mainExif-tab-related" aria-controls="mainExif-tabpanel-related">
                                            <%- await readSvg("organization_20_regular.svg"); %>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mainExifList base-scrollbar js-tabContent-info" id="mainExif-tabpanel-info" role="tabpanel" aria-labelledby="mainExif-tab-info"> </div>
                            <div class="mainExifRelated base-scrollbar js-tabContent-related" id="mainExif-tabpanel-related" role="tabpanel" aria-labelledby="mainExif-tab-related"> </div>
                        </div>
                    </div>

                </div>

                <div class="main-B"></div>

            </div>

        </div>

        <div class="window-LC window-border"></div>
        <div class="window-RC window-border"></div>
        <div class="window-CT window-border"></div>
        <div class="window-LT window-border"></div>
        <div class="window-RT window-border"></div>
        <div class="window-CB window-border"></div>
        <div class="window-LB window-border"></div>
        <div class="window-RB window-border"></div>

    </div>

    <!-- 文字編輯器 -->
    <div class="textEditor" id="textEditor" style="display:none;">
        <div class="textEditor-box">
            <div class="textEditor-toolbar">
                <div class="textEditor-toolbarItem svg-box js-save" title="" i18n="menu.showSave" role="button">
                    <%- await readSvg("save_20_regular.svg"); %>
                </div>
                <div class="textEditor-toolbarItem svg-box js-pretty" title="" i18n="menu.formatJson" role="button">
                    <%- await readSvg("code_20_regular.svg"); %>
                </div>
                <div class="textEditor-toolbarItem textEditor-toolbarItem__close js-close" role="button" i18n="menu.close" aria-label="Close editor">
                </div>
            </div>
            <div class="textEditor-content">
                <textarea class="textEditor-textarea base-scrollbar"></textarea>
            </div>
        </div>
    </div>

    <!-- 開啟setting視窗時的loading -->
    <div id="loadingSetting">
        <div class="loadingSetting-box">
            <%- await readSvg("settings_20_regular.svg"); %>
        </div>
    </div>

    <!-- 下拉選單 & 右鍵選單 -->
    <%- await include("./Menu.ejs"); %>



</body>

</html>
