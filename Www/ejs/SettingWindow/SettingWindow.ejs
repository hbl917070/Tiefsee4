<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tiefsee Setting</title>

    <!-- 空白 icon -->
    <link rel="icon" href="data:image/x-icon;,">

    <script src="./vender/jquery/jquery.min.js"></script>

    <!-- MiniColors (選擇顏色器) -->
    <script src="./vender/jquery-minicolors/jquery.minicolors.min.js"></script>
    <link href="./vender/jquery-minicolors/jquery.minicolors.css" rel="stylesheet">

    <script src="./js/SvgList.js"></script>
    <script src="./lang/langData.js"></script>

    <script src="./js/SettingWindow.js"></script>
    <link rel="stylesheet" href="./css/SettingWindow.css">
</head>

<body>

    <div class="window">

        <div class="window-left" id="window-left">
            <div class="pagetab base-scrollbar" role="tablist" aria-orientation="vertical">

                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-general" aria-controls="tabsPage-general" i18n="sw.tabs.general" active="true"> 一般 </div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-appearance" aria-controls="tabsPage-appearance" i18n="sw.tabs.appearance"> 外觀 </div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-layout" aria-controls="tabsPage-layout" i18n="sw.tabs.layout"> 版面 </div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-toolbar" aria-controls="tabsPage-toolbar" i18n="sw.tabs.toolbar"> 工具列</div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-hotkey" aria-controls="tabsPage-hotkey" i18n="sw.tabs.hotkey"> 快速鍵 </div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-mouse" aria-controls="tabsPage-mouse" i18n="sw.tabs.mouse"> 滑鼠 </div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-extension" aria-controls="tabsPage-extension" i18n="sw.tabs.association" show-not="storeApp"> 設為預設程式 </div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-advanced" aria-controls="tabsPage-advanced" i18n="sw.tabs.advanced"> 進階設定 </div>

                <div class="page-tabsHr"> </div>

                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-plugin" aria-controls="tabsPage-plugin" i18n="sw.tabs.plugin"> 擴充套件 </div>
                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-quickLook" aria-controls="tabsPage-quickLook" i18n="sw.tabs.quickLook"> 快速預覽 </div>

                <div class="page-tabsHr"> </div>

                <div class="page-tabsBtn js-noDrag" role="tab" aria-selected="false" id="tabsBtn-about" aria-controls="tabsPage-about" i18n="sw.tabs.about"> 關於 </div>

            </div>
        </div>

        <div class="window-right">

            <!-- 標題列 -->
            <div class="window-titlebar">

                <div class="titlebar-text"></div>

                <div class="titlebar-toolbar">
                    <div class="titlebar-toolbar-btn titlebar-toolbar-minimized" role="button" i18n="script.minimizeWindow" title="">
                        <%- await readSvg("window_minimized.svg"); %>
                    </div>
                    <div class="titlebar-toolbar-btn titlebar-toolbar-normal" role="button" i18n="script.restoreWindow" title="" style="display:none;">
                        <%- await readSvg("window_normal.svg"); %>
                    </div>
                    <div class="titlebar-toolbar-btn titlebar-toolbar-maximized" role="button" i18n="script.maximizeWindow" title="">
                        <%- await readSvg("window_maximized.svg"); %>
                    </div>
                    <div class="titlebar-toolbar-btn titlebar-toolbar-close" role="button" i18n="script.closeWindow" title="">
                        <%- await readSvg("window_close.svg"); %>
                    </div>
                </div>

            </div>

            <div class="window-body base-scrollbar-big" id="window-body">
                <%- await include("./pages/General.ejs"); %>
                <%- await include("./pages/Appearance.ejs"); %>
                <%- await include("./pages/Layout.ejs"); %>
                <%- await include("./pages/Toolbar.ejs"); %>
                <%- await include("./pages/Mouse.ejs"); %>
                <%- await include("./pages/Hotkey.ejs"); %>
                <%- await include("./pages/Association.ejs"); %>
                <%- await include("./pages/Advanced.ejs"); %>
                <%- await include("./pages/About.ejs"); %>
                <%- await include("./pages/Plugin.ejs"); %>
                <%- await include("./pages/QuickLook.ejs"); %>
            </div>

            <div class="window-LC window-border"></div>
            <div class="window-RC window-border"></div>
            <div class="window-CT window-border"></div>
            <div class="window-LT window-border"></div>
            <div class="window-RT window-border"></div>
            <div class="window-CB window-border"></div>
            <div class="window-LB window-border"></div>
            <div class="window-RB window-border"></div>

        </div>

</body>

</html>