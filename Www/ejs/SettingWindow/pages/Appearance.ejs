<!-- 外觀 -->
<div class="page-tabsPage" id="tabsPage-appearance" role="tabpanel" aria-labelledby="tabsBtn-appearance">

    <div class="page-title" i18n="sw.tabs.appearance">外觀</div>

    <div class="box">
        <div class="box-title" i18n="sw.theme.defaultTheme">預設主題</div>
        <div id="applyTheme-btns"></div>
    </div>

    <div class="box">
        <div class="box-title" i18n="sw.theme.customTheme">自訂主題</div>

        <div class="text-title" i18n="sw.theme.windowBackgroundColor">視窗背景色</div>
        <div class="text-content">
            <input class="text-input" type="text" data-format="rgba" id="text-colorWindowBackground">
        </div>

        <div class="text-title" i18n="sw.theme.windowBorderColor">視窗邊框色</div>
        <div class="text-content">
            <input class="text-input" type="text" data-format="rgba" id="text-colorWindowBorder">
        </div>

        <div class="text-title" i18n="sw.theme.textColor">文字顏色</div>
        <div class="text-content">
            <input class="text-input" data-format="rgb" type="text" id="text-colorWhite">
        </div>

        <div class="text-title" i18n="sw.theme.accentColor">強調顏色</div>
        <div class="text-content">
            <input class="text-input" data-format="rgb" type="text" id="text-colorBlue">
        </div>

        <div class="text-title" i18n="sw.theme.blockColor">區塊底色</div>
        <div class="text-content">
            <input class="text-input" data-format="rgb" type="text" id="text-colorBlack">
        </div>

    </div>

    <div class="box">
        <div class="box-title" i18n="sw.textAndIcon.title"> 文字與圖示 </div>

        <div class="text-title" i18n="sw.textAndIcon.textStrokeWidth"> 文字粗細 </div>
        <div class="text-content">
            <select class="text-input" id="select-fontWeight">
                <option value="100" i18n="sw.textAndIcon.text_1">1(最細)</option>
                <option value="200">2</option>
                <option value="300">3</option>
                <option value="400" i18n="sw.textAndIcon.text_4">4(預設)</option>
                <option value="500">5</option>
                <option value="600">6</option>
                <option value="700">7</option>
                <option value="800">8</option>
                <option value="900" i18n="sw.textAndIcon.text_9">9(最粗)</option>
            </select>
        </div>

        <div class="text-title" i18n="sw.textAndIcon.iconStrokeWidth"> 圖示粗細 </div>
        <div class="text-content">
            <select class="text-input" id="select-svgWeight">
                <option value="0px" i18n="sw.textAndIcon.icon_0">0(最細、預設)</option>
                <option value="0.1px">1</option>
                <option value="0.2px">2</option>
                <option value="0.3px">3</option>
                <option value="0.4px">4</option>
                <option value="0.5px">5</option>
                <option value="0.6px">6</option>
                <option value="0.7px">7</option>
                <option value="0.8px">8</option>
                <option value="0.9px">9</option>
                <option value="1px" i18n="sw.textAndIcon.icon_10">10(最粗)</option>
            </select>
        </div>
    </div>

    <div class="box">
        <div class="box-title" i18n="sw.windowSetting.title"> 視窗設定 </div>

        <div class="text-title" i18n="sw.windowSetting.zoom"> 視窗縮放 (0.5~3.0)</div>
        <div class="text-content">
            <input class="text-input" type="number" id="text-zoomFactor">
        </div>

        <div class="text-title" i18n="sw.windowSetting.roundedCorners"> 視窗圓角 (0~15)</div>
        <div class="text-content">
            <input class="text-input" type="number" id="text-windowBorderRadius">
        </div>

        <div class="text-title">
            <span i18n="sw.windowSetting.windowStyle"> 視窗效果 </span>
            <div class="img-help" data-i18n="sw.windowSetting.tooltip">
                <%- await readSvg("question_circle_20_regular.svg"); %>
            </div>
        </div>
        <div class="text-content">
            <select class="text-input" id="select-windowStyle">
                <option value="none" i18n="sw.none"> None </option>

                <option value="aero"> AERO </option>

                <option value="default" i18n="sw.default"> 預設 </option>

                <option value="acrylicDark"> Acrylic Dark </option>
                <option value="micaDark"> Mica Dark </option>
                <option value="micaAltDark"> MicaAlt Dark </option>

                <option value="acrylicLight"> Acrylic Light </option>
                <option value="micaLight"> Mica Light </option>
                <option value="micaAltLight"> MicaAlt Light </option>
            </select>
        </div>
        <div class="text-content">
            <div class="btn" role="button" id="btn-windowStyle-restart" i18n="sw.reloadRequired"> 重新啟動 Tiefsee </div>
        </div>
        <div class="text-content">
            <div class="btn" role="button" id="btn-applySuggestedColor" i18n="sw.windowSetting.applySuggestedColor"> 套用建議配色 </div>
        </div>
    </div>

</div>
