<!-- 快速預覽 -->
<div class="page-tabsPage" id="tabsPage-quickLook" role="tabpanel" aria-labelledby="tabsBtn-quickLook">
    <div class="page-title" i18n="sw.tabs.quickLook"> 快速預覽 </div>

    <div class="box">
        <div class="box-title" i18n="sw.quickLook.title"> 快速預覽桌面或資料夾的檔案 </div>

        <div class="text-title" i18n="sw.quickLook.subtitle">「啟動模式」如果為「直接啟動」則無法使用快速預覽 </div>

        <div style="height:20px"></div>

        <!-- 未安裝QuickLook才會顯示此訊息 -->
        <div id="quickLook-noInstalled" style="display:none">
            <div class="text-title">
                <span class="color-warning" i18n="sw.quickLook.notInstalledQuickLook">
                    必須安裝擴充套件「QuickLook」才能使用此功能
                </span>
            </div>
            <div style="height:20px"></div>
        </div>

        <div id="quickLook-box">
            <div class="text-title" i18n="sw.quickLook.longPressSpacebar"> 長按「空白鍵」觸發 </div>
            <div class="text-content">
                <label class="switch">
                    <input type="checkbox" id="switch-keyboardSpaceRun">
                    <span class="slider round"></span>
                </label>
            </div>
            <div class="text-title" i18n="sw.quickLook.longPressMousewheel"> 長按「滑鼠滾輪」觸發 </div>
            <div class="text-content">
                <label class="switch">
                    <input type="checkbox" id="switch-mouseMiddleRun">
                    <span class="slider round"></span>
                </label>
            </div>
        </div>

    </div>

</div>
