<!-- 設為預設程式 -->
<div class="page-tabsPage" id="tabsPage-extension" role="tabpanel" aria-labelledby="tabsBtn-extension">
    <div class="page-title" i18n="sw.tabs.association"> 設為預設程式 </div>

    <div class="box">
        <div class="box-title" id="association-step1-title" i18n="sw.association.step1"> 步驟1、把Tiefsee關聯到特定副檔名 </div>
        <div class="text-title" id="association-step1-subtitle" i18n="sw.association.step1Subtitle"> (一行代表一種副檔名) </div>
        <div class="text-content">
            <textarea class="text-input base-scrollbar" rows="7" id="text-extension" aria-labelledby="association-step1-title association-step1-subtitle"></textarea>
        </div>
        <div class="btn" role="button" id="btn-extension" aria-label="" i18n="sw.association.applyFileTypeAssociation">套用</div>
    </div>

    <div class="box">
        <div class="box-title" i18n="sw.association.step2"> 步驟2、修改系統預設APP </div>
        <div class="text-title" i18n="sw.association.step2Subtitle">開啟系統設定後將「相片檢視器」修改成「Tiefsee」 </div>
        <div class="btn" role="button" id="btn-openSystemSettings" i18n="sw.association.openSystemSettings">開啟系統設定
        </div>
    </div>

    <!-- 水平線 -->
    <div style="height:40px;"></div>
    <div style="background:url(&quot;data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACgAAAAUAQMAAADFiO34AAAABlBMVEUAAAD///+l2Z/dAAAAAnRSTlMAZtJCCVUAAAArSURBVAjXYwACBQYQcEAiG0AEIwOCZAKTLEgkBxIpwIAwRgHZGHTDmOAkAKrqAtL90ZhdAAAAAElFTkSuQmCC&quot;);
        height: 15px;
        pointer-events: none;
        border: 1px solid rgba(255, 255, 255, 0.4);
        background-position:15px,0;">
    </div>
    <div style="height:40px;"></div>

    <!-- <div class="page-title" i18n="sw.association.removeAssociation"> 解除預設程式 </div> -->
    <div class="box">
        <div class="box-title" id="association-remove-title" i18n="sw.association.removeFileTypeAssociation"> 解除副檔名關聯 </div>
        <div class="text-title" id="association-remove-subtitle" i18n="sw.association.step1Subtitle"> (一行代表一種副檔名) </div>
        <div class="text-content">
            <textarea class="text-input base-scrollbar" rows="7" id="text-disassociate" aria-labelledby="association-remove-title association-remove-subtitle"></textarea>
        </div>
        <div class="btn" role="button" id="btn-disassociate" aria-label="" i18n="sw.association.applyRemovalOfFileTypeAssociation">套用</div>
    </div>
</div>
